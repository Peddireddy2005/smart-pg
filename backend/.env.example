# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
MONGO_URI=mongodb://localhost:27017/smart-pg

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d

# ---- Google OAuth (https://console.cloud.google.com/apis/credentials) ----
# Create an "OAuth client ID" of type "Web application" and add your
# frontend origin(s) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id.apps.googleusercontent.com

# ---- CORS (comma separated list of allowed frontend origins) ----
CLIENT_URLS=http://localhost:5173,https://smart-pg-lake.vercel.app

# ---- Razorpay (https://dashboard.razorpay.com/app/keys) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# ---- Cloudinary (https://cloudinary.com/console) ----
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Smart PG <no-reply@smartpg.com>"

# ---- Misc ----
RESET_PASSWORD_EXPIRE_MIN=30
FRONTEND_URL=http://localhost:5173
