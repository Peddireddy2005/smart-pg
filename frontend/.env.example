# Backend API base URL (no trailing slash, no /api suffix — services/api.js appends /api)
VITE_API_URL=http://localhost:5000

# Razorpay publishable key id (same value as backend RAZORPAY_KEY_ID — this one is safe to expose)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Google OAuth Client ID (same value as backend GOOGLE_CLIENT_ID — safe to expose, it's public by design)
VITE_GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id.apps.googleusercontent.com
